datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Academy {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  address     String?
  phone       String?
  email       String?
  mapUrl      String?
  mapLatitude  Float?
  mapLongitude Float?
  heroImageUrl String?
  naverBlogUrl String?
  instagramUrl String?
  showStatCounters Boolean @default(true)
  statCounters String? @db.Text
  showTestimonials Boolean @default(true)
  testimonials String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  theme       AcademyTheme?
  features    AcademyFeature?
  users       User[]
  notices     Notice[]
  teachers    Teacher[]
  students    Student[]
  programs    Program[]
  schedules   Schedule[]
  inquiries   Inquiry[]
  files       FileAsset[]
  galleryImages AcademyGalleryImage[]
  attendanceSetting AttendanceSetting?
  attendanceRecords AttendanceRecord[]
  schoolExamResults SchoolExamResult[]
  messages          Message[]
  dailyQuizzes      DailyQuiz[]
  programNotices    ProgramNotice[]
  testCategories    TestCategory[]

  @@index([slug])
}

model AcademyGalleryImage {
  id          String   @id @default(cuid())
  academyId   String
  imageUrl    String
  title       String?
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([academyId, order])
}

model AcademyTheme {
  id             String  @id @default(cuid())
  academyId      String  @unique
  primaryColor   String  @default("#2563EB")
  secondaryColor String  @default("#0F172A")
  logoKey        String?
  logoUrl        String?
  fontFamily     String?
  headerStyle    String  @default("default")
  academy        Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
}

model AcademyFeature {
  id             String  @id @default(cuid())
  academyId      String  @unique
  showTeachers   Boolean @default(true)
  showCurriculum Boolean @default(true)
  showSchedule   Boolean @default(true)
  showNotices    Boolean @default(true)
  showInquiry    Boolean @default(true)
  showLocation   Boolean @default(true)
  enableAI       Boolean @default(false)
  enablePayment  Boolean @default(false)
  enableAttend   Boolean @default(false)
  academy        Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
}

model User {
  id           String    @id @default(cuid())
  academyId    String?
  email        String
  name         String
  passwordHash String?
  role         UserRole  @default(ADMIN)
  createdAt    DateTime  @default(now())
  academy      Academy?  @relation(fields: [academyId], references: [id])
  teacher      Teacher?
  student      Student?
  homeworks    Homework[]
  progressLogs ProgressLog[]
  testResults     TestResult[]
  testCategories  TestCategory[]
  attendanceUpdates AttendanceRecord[]
  accounts     Account[]
  sessions     Session[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  programNotices   ProgramNotice[]

  @@unique([email, academyId])
  @@index([academyId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  TEACHER
  STUDENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notice {
  id        String     @id @default(cuid())
  academyId String
  title     String
  content   String     @db.LongText
  isPinned  Boolean    @default(false)
  status    PostStatus @default(PUBLISHED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  academy   Academy    @relation(fields: [academyId], references: [id])
  attachments FileAsset[]

  @@index([academyId, createdAt])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgramNoticeType {
  MAKEUP
  CANCEL
  SCHEDULE_CHANGE
  OTHER
}

model ProgramNotice {
  id        String            @id @default(cuid())
  academyId String
  programId String
  authorId  String
  type      ProgramNoticeType
  title     String
  content   String?           @db.Text
  isVisible Boolean           @default(true)

  makeupDate      DateTime?
  makeupStartTime String?
  makeupEndTime   String?

  cancelDate DateTime?

  changeDate     DateTime?
  changeFromTime String?
  changeToTime   String?
  dayOfWeek      Int?
  originalDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([academyId, programId, createdAt])
  @@index([authorId])
}

model Teacher {
  id        String   @id @default(cuid())
  academyId String
  userId    String?  @unique
  name      String
  subject   String
  bio       String?  @db.Text
  profileImageUrl String?
  introVideoUrl   String?
  introVideoUrls  String?  @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  academy   Academy  @relation(fields: [academyId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
  programs  Program[]

  @@index([academyId, order])
}

model Program {
  id          String        @id @default(cuid())
  academyId   String
  teacherId   String?
  title       String
  mode        ProgramMode
  targetLevel TargetLevel
  schoolName  String?
  grade       String?
  subject     String?
  description String?       @db.Text
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  academy     Academy       @relation(fields: [academyId], references: [id])
  teacher     Teacher?      @relation(fields: [teacherId], references: [id])
  schedules   Schedule[]
  enrollments Enrollment[]
  homeworks   Homework[]
  progressLogs ProgressLog[]
  testResults TestResult[]
  programNotices ProgramNotice[]

  @@index([academyId, mode, targetLevel, order])
  @@index([academyId, teacherId])
}

enum ProgramMode {
  SCHOOL_EXAM
  LEVEL
}

enum TargetLevel {
  ELEMENTARY
  MIDDLE
  HIGH
}

model Schedule {
  id        String   @id @default(cuid())
  academyId String
  programId String?
  title     String
  subject   String?
  teacher   String?
  room      String?
  dayOfWeek Int
  startTime String
  endTime   String
  color     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  academy           Academy           @relation(fields: [academyId], references: [id])
  program           Program?          @relation(fields: [programId], references: [id])
  attendanceRecords AttendanceRecord[]

  @@index([academyId, dayOfWeek, startTime])
  @@index([academyId, programId])
}

model Homework {
  id        String    @id @default(cuid())
  academyId String
  programId String
  studentId String?
  authorId  String
  title       String
  content     String    @db.Text
  startDate   DateTime?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  isVisible   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  program     Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  student     Student?             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author      User                 @relation(fields: [authorId], references: [id])
  completions HomeworkCompletion[]

  @@index([academyId, programId, createdAt])
  @@index([academyId, studentId])
  @@index([authorId])
}

model HomeworkCompletion {
  id          String   @id @default(cuid())
  homeworkId  String
  studentId   String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
}

model ProgressLog {
  id        String   @id @default(cuid())
  academyId String
  programId String
  studentId String?
  authorId  String
  classDate DateTime
  content      String   @db.Text
  nextPlan     String?  @db.Text
  homeworkRate Int?
  isVisible    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([academyId, programId, classDate])
  @@index([academyId, studentId])
  @@index([authorId])
}

model TestCategory {
  id          String       @id @default(cuid())
  academyId   String
  authorId    String?
  name        String
  color       String       @default("#6366f1")
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  academy     Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id])
  testResults TestResult[]

  @@index([academyId, authorId, order])
}

model TestResult {
  id         String        @id @default(cuid())
  academyId  String
  programId  String
  studentId  String
  authorId   String
  categoryId String?
  testName   String
  score      String
  testedAt   DateTime
  memo       String?       @db.Text
  isPassed   Boolean?
  isVisible  Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  program    Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id])
  category   TestCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([academyId, programId, testedAt])
  @@index([academyId, studentId, testedAt])
  @@index([academyId, testName])
  @@index([academyId, categoryId])
  @@index([authorId])
}

model Inquiry {
  id        String        @id @default(cuid())
  academyId String
  name      String
  phone     String
  email     String?
  subject   String?
  content   String        @db.Text
  status    InquiryStatus @default(PENDING)
  memo      String?
  createdAt DateTime      @default(now())
  academy   Academy       @relation(fields: [academyId], references: [id])

  @@index([academyId, createdAt])
}

model Student {
  id          String       @id @default(cuid())
  academyId   String
  userId      String?      @unique
  name        String
  schoolName  String?
  grade       String?
  phone       String?
  parentPhone String?
  memo        String?      @db.Text
  isActive    Boolean      @default(true)
  withdrawnAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  academy     Academy      @relation(fields: [academyId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  enrollments Enrollment[]
  homeworks           Homework[]
  progressLogs        ProgressLog[]
  testResults         TestResult[]
  attendanceRecords   AttendanceRecord[]
  schoolExamResults   SchoolExamResult[]
  homeworkCompletions HomeworkCompletion[]
  dailyQuizAttempts   DailyQuizAttempt[]

  @@index([academyId, name])
}

model Enrollment {
  id        String           @id @default(cuid())
  academyId String
  studentId String
  programId String
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program   Program          @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([studentId, programId])
  @@index([academyId, status])
  @@index([programId])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model AttendanceSetting {
  id                  String   @id @default(cuid())
  academyId           String   @unique
  isEnabled           Boolean  @default(false)
  latitude            Float?
  longitude           Float?
  radiusMeters        Int      @default(100)
  earlyCheckinMinutes Int      @default(30)
  lateGraceMinutes    Int      @default(5)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  academy             Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  academyId      String
  studentId      String
  scheduleId     String?
  attendanceDate DateTime
  checkedAt      DateTime?
  status         AttendanceStatus @default(PRESENT)
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  distanceMeters Float?
  source         AttendanceSource @default(STUDENT_LOCATION)
  memo           String?          @db.Text
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  academy        Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedule       Schedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  updatedBy      User?            @relation(fields: [updatedById], references: [id])

  @@unique([studentId, scheduleId, attendanceDate])
  @@index([academyId, attendanceDate, status])
  @@index([academyId, studentId, attendanceDate])
  @@index([scheduleId])
  @@index([updatedById])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AttendanceSource {
  STUDENT_LOCATION
  ADMIN_MANUAL
}

model SchoolExamResult {
  id         String   @id @default(cuid())
  academyId  String
  studentId  String
  examType   String
  subject    String
  score      Int?
  grade      Int?
  examYear   Int
  semester   Int
  schoolYear Int?
  memo       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  academy    Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([academyId, studentId])
  @@index([academyId, examYear, semester])
  @@index([academyId, subject])
}

model Message {
  id         String    @id @default(cuid())
  academyId  String
  senderId   String
  receiverId String
  content    String    @db.Text
  isRead            Boolean   @default(false)
  readAt            DateTime?
  deletedBySender   Boolean   @default(false)
  deletedByReceiver Boolean   @default(false)
  link              String?
  createdAt         DateTime  @default(now())

  academy  Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  sender   User    @relation("SentMessages", fields: [senderId], references: [id])
  receiver User    @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([academyId, receiverId, createdAt])
  @@index([academyId, senderId])
}

model DailyQuiz {
  id          String   @id @default(cuid())
  academyId   String
  date        DateTime @db.Date
  question    String   @db.Text
  answer      Boolean
  explanation String?  @db.Text
  createdAt   DateTime @default(now())

  academy  Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  attempts DailyQuizAttempt[]

  @@unique([academyId, date])
  @@index([academyId, date])
}

model DailyQuizAttempt {
  id        String   @id @default(cuid())
  academyId String
  quizId    String
  studentId String
  answer    Boolean
  isCorrect Boolean
  createdAt DateTime @default(now())

  quiz    DailyQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([academyId, isCorrect])
  @@index([studentId])
}

model FileAsset {
  id         String   @id @default(cuid())
  academyId  String
  noticeId   String?
  uploaderId String
  objectKey  String   @unique
  displayName String?
  publicUrl  String?
  mimeType   String
  size       Int
  purpose    String?
  createdAt  DateTime @default(now())
  academy    Academy  @relation(fields: [academyId], references: [id])
  notice     Notice?  @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([academyId])
  @@index([noticeId])
}
